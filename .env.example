# Contact form delivery (optional).
#
# With these unset the form still validates and submits, but the server action
# reports "unconfigured" and the UI falls back to offering a mailto link.
# Set both to turn on real delivery via Resend.

RESEND_API_KEY=
# Must be a domain you have verified with Resend, e.g. hello@adnansadar.com
CONTACT_FROM_EMAIL=
